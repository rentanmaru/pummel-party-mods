<Project>
  <!-- PCごとのゲームの場所。GamePath.user.props.example をコピーして作る -->
  <Import Project="$(MSBuildThisFileDirectory)GamePath.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)GamePath.user.props')" />

  <PropertyGroup>
    <!-- user.props が無いときはSteamの既定の場所を使う -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Pummel Party</GameDir>
    <ManagedDir>$(GameDir)\PummelParty_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>

    <!-- Unity 2021.3 (Mono) で動く設定 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- ここから下は全Mod共通の参照 -->
  <ItemGroup>
    <!-- ゲームの非公開メンバーをビルド時だけ参照できるようにする（実行時には不要） -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx本体（ゲームフォルダに導入したものを参照。出力にはコピーしない） -->
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />

    <!-- ゲーム本体のコード -->
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" Publicize="true" />

    <!-- Unityのモジュール（ゲームに同梱されているものをそのまま使う） -->
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
  </ItemGroup>
</Project>
