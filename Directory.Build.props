<Project>
  <!-- PCごとのゲームの場所。GamePath.user.props.example をコピーして作る -->
  <Import Project="$(MSBuildThisFileDirectory)GamePath.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)GamePath.user.props')" />

  <PropertyGroup>
    <!-- user.props が無いときはSteamの既定の場所を使う -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Pummel Party</GameDir>
    <ManagedDir>$(GameDir)\PummelParty_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>

    <!-- Unity 2021.3 (Mono) で動く設定 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
  </PropertyGroup>
</Project>
